# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
APP_NAME="Etudesk"
NODE_ENV=development
PORT=3000

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@localhost:5432/etudesk-db

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION (JWT)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ═══════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET=your-access-secret-min-64-chars-use-crypto-randomBytes-to-generate
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-use-crypto-randomBytes-to-generate

# ═══════════════════════════════════════════════════════════════
# AI - OPENAI
# ═══════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_NANO_MODEL=gpt-4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ═══════════════════════════════════════════════════════════════
# AI - ANTHROPIC
# ═══════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ═══════════════════════════════════════════════════════════════
# AI - GEMINI
# ═══════════════════════════════════════════════════════════════
GEMINI_API_KEY=your-gemini-api-key

# ═══════════════════════════════════════════════════════════════
# PINECONE (VECTOR DB)
# ═══════════════════════════════════════════════════════════════
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=etudesk
PINECONE_HOST=https://your-index.svc.pinecone.io
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine

# ═══════════════════════════════════════════════════════════════
# BRAVE SEARCH
# ═══════════════════════════════════════════════════════════════
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# ═══════════════════════════════════════════════════════════════
# YOUTUBE
# ═══════════════════════════════════════════════════════════════
YOUTUBE_API_KEY=your-youtube-api-key

# ═══════════════════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ═══════════════════════════════════════════════════════════════
# WHATSAPP (ULTRAMSG)
# ═══════════════════════════════════════════════════════════════
ULTRAMSG_INSTANCE_ID=your-instance-id
ULTRAMSG_TOKEN=your-ultramsg-token
ULTRAMSG_ALLOWED_IPS=

# ═══════════════════════════════════════════════════════════════
# EMAIL (SMTP)
# For development: use Mailhog (docker-compose up -d mailhog)
# For production: use real SMTP server
# ═══════════════════════════════════════════════════════════════
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Production example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=Etudesk <noreply@etudesk.com>
MAIL_FROM_ADDRESS=noreply@etudesk.com
MAIL_FROM_NAME=Etudesk

# ═══════════════════════════════════════════════════════════════
# PAYSTACK (PAYMENTS)
# Use test keys for development, live keys for production
# ═══════════════════════════════════════════════════════════════
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/webhooks/paystack

# ═══════════════════════════════════════════════════════════════
# AWS
# ═══════════════════════════════════════════════════════════════
AWS_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════
# CORS & SECURITY
# IMPORTANT: Never use * in production!
# Specify exact origins for your frontend apps
# ═══════════════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:19006
ADMIN_EMAILS=admin@yourdomain.com

# ═══════════════════════════════════════════════════════════════
# NEO4J GRAPH DATABASE
# ═══════════════════════════════════════════════════════════════
NEO4J_URI=neo4j+s://your-neo4j-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
