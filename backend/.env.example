# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
APP_NAME="Etudesk"
NODE_ENV=development
PORT=3000
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=
COPILOT_TIMEZONE=UTC

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@localhost:5432/etudesk-db

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION (JWT)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ═══════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET=your-access-secret-min-64-chars-use-crypto-randomBytes-to-generate
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-use-crypto-randomBytes-to-generate

# ═══════════════════════════════════════════════════════════════
# AI — single OpenAI-compatible provider
# ═══════════════════════════════════════════════════════════════

AI_API_KEY=
AI_BASE_URL=https://api.provider.example/v1/openai
AI_INFERENCE_BASE_URL=https://api.provider.example/v1/inference
AI_MODEL_AGENT=provider/agent-model
AI_MODEL_FAST=meta-llama/Llama-4-Scout-17B-16E-Instruct
AI_MODEL_SUGGESTION=meta-llama/Llama-4-Scout-17B-16E-Instruct
AI_MODEL_MATCH=meta-llama/Llama-4-Scout-17B-16E-Instruct
AI_MODEL_VISION=Qwen/Qwen3-VL-235B-A22B-Instruct
AI_MODEL_IMAGE=black-forest-labs/FLUX-1-schnell
AI_MODEL_STT=openai/whisper-large-v3-turbo
AI_MODEL_TTS=hexgrad/Kokoro-82M
AI_MODEL_EMBEDDING=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Optional: free content moderation only
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# ═══════════════════════════════════════════════════════════════
# BRAVE SEARCH
# ═══════════════════════════════════════════════════════════════
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# ═══════════════════════════════════════════════════════════════
# YOUTUBE
# ═══════════════════════════════════════════════════════════════
YOUTUBE_API_KEY=your-youtube-api-key

# ═══════════════════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ═══════════════════════════════════════════════════════════════
# EMAIL
# Provider options: smtp (Mailhog for dev), resend (production)
# ═══════════════════════════════════════════════════════════════
EMAIL_PROVIDER=smtp
EMAIL_FROM=Etudesk <noreply@etudesk.com>

# SMTP settings (for Mailhog in development)
# Run: docker-compose up -d mailhog
# View emails at: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# Resend settings (for production)
# Get API key at: https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# PAYSTACK (PAYMENTS)
# Use test keys for development, live keys for production
# ═══════════════════════════════════════════════════════════════
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=etudesk://billing/callback
PAYSTACK_CURRENCY=XOF

# Billing credits conversion
# 1 means 1 credit per 100 FCFA
CREDITS_PER_100_FCFA=1

# ═══════════════════════════════════════════════════════════════
# AWS
# ═══════════════════════════════════════════════════════════════
AWS_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════
# CORS & SECURITY
# IMPORTANT: Never use * in production!
# Specify exact origins for your frontend apps
# ═══════════════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:19006
ADMIN_EMAILS=admin@yourdomain.com

# ═══════════════════════════════════════════════════════════════
# PAYSTACK WEBHOOKS
# ═══════════════════════════════════════════════════════════════
PAYSTACK_WEBHOOK_URL=http://localhost:3000/api/v1/billing/webhooks/paystack

# ═══════════════════════════════════════════════════════════════
# UPLOADS
# ═══════════════════════════════════════════════════════════════
UPLOAD_DIR=./uploads

# ═══════════════════════════════════════════════════════════════
# LOGGING
# Options: debug, info, warn, error
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# APP URL (used for callbacks & links in emails)
# ═══════════════════════════════════════════════════════════════
APP_URL=http://localhost:3000
