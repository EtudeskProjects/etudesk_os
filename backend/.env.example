# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
APP_NAME="Etudesk"
NODE_ENV=development
PORT=3000
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=
COPILOT_TIMEZONE=UTC

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@localhost:5432/etudesk-db

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION (JWT)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ═══════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET=your-access-secret-min-64-chars-use-crypto-randomBytes-to-generate
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-use-crypto-randomBytes-to-generate

# ═══════════════════════════════════════════════════════════════
# AI — OpenAI by default; optional OpenAI-compatible provider override
# ═══════════════════════════════════════════════════════════════

AI_API_KEY=
OPENAI_API_KEY=
# Leave AI_BASE_URL empty for OpenAI. Set it only for OpenAI-compatible providers.
AI_BASE_URL=
AI_INFERENCE_BASE_URL=https://api.provider.example/v1/inference
AI_MODEL_AGENT=gpt-5.4-mini
AI_MODEL_FAST=gpt-5.4-mini
AI_MODEL_SUGGESTION=gpt-5.4-mini
AI_MODEL_MATCH=gpt-5.4-mini
AI_MODEL_VISION=gpt-5.4-mini
AI_MODEL_IMAGE=gpt-image-1-mini
AI_MODEL_STT=gpt-4o-mini-transcribe
AI_MODEL_TTS=gpt-4o-mini-tts
AI_MODEL_EMBEDDING=text-embedding-3-small
EMBEDDING_DIMENSION=1024

# Optional: content moderation
OPENAI_MODERATION_MODEL=omni-moderation-latest

# ═══════════════════════════════════════════════════════════════
# BRAVE SEARCH
# ═══════════════════════════════════════════════════════════════
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# ═══════════════════════════════════════════════════════════════
# YOUTUBE
# ═══════════════════════════════════════════════════════════════
YOUTUBE_API_KEY=your-youtube-api-key

# ═══════════════════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ═══════════════════════════════════════════════════════════════
# EMAIL
# Provider options: smtp (Mailhog for dev), resend (Resend API)
# ═══════════════════════════════════════════════════════════════
EMAIL_PROVIDER=smtp
EMAIL_FROM=Etudesk <noreply@etudesk.com>
# Set to true only when you intentionally want failed dev emails to log OTPs
# and still return success to the client. Keep false for QA with real email.
OTP_EMAIL_DEV_FALLBACK=false

# WhatsApp OTP via UltraMsg. Leave empty to keep the channel unavailable.
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# SMTP settings (for Mailhog in development)
# Run: docker-compose up -d mailhog
# View emails at: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# Resend settings (for production)
# Get API key at: https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# PAYSTACK (PAYMENTS)
# Use test keys for development, live keys for production
# ═══════════════════════════════════════════════════════════════
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=etudesk://billing/callback
PAYSTACK_CURRENCY=XOF

# Billing credits conversion
# 1 means 1 credit per 100 FCFA
CREDITS_PER_100_FCFA=1

# ═══════════════════════════════════════════════════════════════
# AWS
# ═══════════════════════════════════════════════════════════════
AWS_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════
# CORS & SECURITY
# IMPORTANT: Never use * in production!
# Specify exact origins for your frontend apps
# ═══════════════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:19006
ADMIN_EMAILS=admin@yourdomain.com

# ═══════════════════════════════════════════════════════════════
# PAYSTACK WEBHOOKS
# ═══════════════════════════════════════════════════════════════
PAYSTACK_WEBHOOK_URL=http://localhost:3000/api/v1/billing/webhooks/paystack

# ═══════════════════════════════════════════════════════════════
# UPLOADS
# ═══════════════════════════════════════════════════════════════
UPLOAD_DIR=./uploads

# ═══════════════════════════════════════════════════════════════
# LOGGING
# Options: debug, info, warn, error
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# APP URL (used for callbacks & links in emails)
# ═══════════════════════════════════════════════════════════════
APP_URL=http://localhost:3000
