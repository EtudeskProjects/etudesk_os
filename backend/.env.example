# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
APP_NAME="Etudesk"
NODE_ENV=development
PORT=3000

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@localhost:5432/etudesk-db

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION (JWT)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ═══════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET=your-access-secret-min-64-chars-use-crypto-randomBytes-to-generate
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-use-crypto-randomBytes-to-generate

# ═══════════════════════════════════════════════════════════════
# AI — Multi-provider (3 providers simultanes)
# Chaque provider est utilise pour ses forces :
# - Anthropic Claude : agents copilot (Sonnet), guardrails/summaries (Haiku)
# - Google Gemini : suggestions formulaires (Flash Lite, le moins cher)
# - OpenAI : images, web search, embeddings, STT, vision/extraction
# Les 3 cles sont requises pour le fonctionnement complet.
# ═══════════════════════════════════════════════════════════════

# OPENAI (requis — images, STT, moderation, embeddings, web search, vision)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ANTHROPIC CLAUDE (requis — agents copilot)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Optionnel: override du modele agent (alias Sonnet par defaut dans le code)
# ANTHROPIC_MODEL_AGENT=claude-sonnet-4-6

# ═══════════════════════════════════════════════════════════════
# PINECONE (VECTOR DB)
# ═══════════════════════════════════════════════════════════════
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=etudesk
PINECONE_HOST=https://your-index.svc.pinecone.io
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine

# ═══════════════════════════════════════════════════════════════
# BRAVE SEARCH
# ═══════════════════════════════════════════════════════════════
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# ═══════════════════════════════════════════════════════════════
# YOUTUBE
# ═══════════════════════════════════════════════════════════════
YOUTUBE_API_KEY=your-youtube-api-key

# ═══════════════════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ═══════════════════════════════════════════════════════════════
# WHATSAPP (ULTRAMSG)
# ═══════════════════════════════════════════════════════════════
ULTRAMSG_INSTANCE_ID=your-instance-id
ULTRAMSG_TOKEN=your-ultramsg-token
ULTRAMSG_ALLOWED_IPS=
WHATSAPP_SUPPORT_AGENT_ENABLED=false

# ═══════════════════════════════════════════════════════════════
# EMAIL
# Provider options: smtp (Mailhog for dev), resend (production)
# ═══════════════════════════════════════════════════════════════
EMAIL_PROVIDER=smtp
EMAIL_FROM=Etudesk <noreply@etudesk.com>

# SMTP settings (for Mailhog in development)
# Run: docker-compose up -d mailhog
# View emails at: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# Resend settings (for production)
# Get API key at: https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# PAYSTACK (PAYMENTS)
# Use test keys for development, live keys for production
# ═══════════════════════════════════════════════════════════════
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=etudesk://billing/callback
PAYSTACK_CURRENCY=XOF

# Billing credits conversion
# 1 means 1 credit per 100 FCFA
CREDITS_PER_100_FCFA=1

# ═══════════════════════════════════════════════════════════════
# AWS
# ═══════════════════════════════════════════════════════════════
AWS_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════
# CORS & SECURITY
# IMPORTANT: Never use * in production!
# Specify exact origins for your frontend apps
# ═══════════════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:19006
ADMIN_EMAILS=admin@yourdomain.com

# ═══════════════════════════════════════════════════════════════
# PAYSTACK WEBHOOKS
# ═══════════════════════════════════════════════════════════════
PAYSTACK_WEBHOOK_URL=http://localhost:3000/api/v1/billing/webhooks/paystack

# ═══════════════════════════════════════════════════════════════
# UPLOADS
# ═══════════════════════════════════════════════════════════════
UPLOAD_DIR=./uploads

# ═══════════════════════════════════════════════════════════════
# LOGGING
# Options: debug, info, warn, error
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# APP URL (used for callbacks & links in emails)
# ═══════════════════════════════════════════════════════════════
APP_URL=http://localhost:3000

# DeepInfra (OpenAI-compatible) — open-source model provider
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
