# Database
DATABASE_URL=postgresql://user:password@localhost:5432/etudesk

# AI - OpenAI
OPENAI_API_KEY=sk-proj-xxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI - Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# AI - Gemini
GEMINI_API_KEY=AIzaSyxxx

# Pinecone
PINECONE_API_KEY=pcsk_xxx
PINECONE_INDEX=etudesk
PINECONE_HOST=https://your-index.svc.xxx.pinecone.io
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine

# AWS
AWS_REGION=us-east-1

# Server
PORT=3000
NODE_ENV=development

# JWT Secrets (CHANGE IN PRODUCTION - use strong random strings!)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# Email (Mailhog for development, real SMTP for production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# For production:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=Etudesk <noreply@etudesk.com>

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
