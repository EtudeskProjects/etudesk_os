{
  "name": "etudesk-backend",
  "version": "1.0.0",
  "description": "Backend API pour Etudesk",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && rm -rf dist/i18n/locales dist/services/copilot/skills/definitions && cp -r src/i18n/locales dist/i18n/locales && cp -r src/services/copilot/skills/definitions dist/services/copilot/skills/definitions",
    "start": "node dist/index.js",
    "db:drop-schema": "node src/database/drop-schema.js",
    "db:reset": "npm run db:drop-schema && npm run db:migrate",
    "db:recreate": "node src/database/recreate-db.js",
    "db:migrate": "node src/database/run-migrations.js",
    "db:seed": "node src/database/seed-etudesk-os.js",
    "db:reset:seed": "npm run db:reset && npm run db:seed",
    "seed:pinecone": "tsx src/scripts/seed-pinecone.ts",
    "pinecone:reset:seed": "tsx src/scripts/pinecone-reset-and-seed.ts",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "test:skills": "tsx src/services/copilot/skills/__tests__/skill-loader.test.ts",
    "test:copilot": "tsx src/services/copilot/tools/__tests__/tools-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@google/genai": "^1.42.0",
    "@openai/agents": "^0.4.4",
    "@pinecone-database/pinecone": "^3.0.3",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-stringify": "^6.6.0",
    "docx": "^9.5.1",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "i18next": "^25.8.4",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.9.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "openai": "^4.70.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.0",
    "resend": "^6.9.1",
    "sharp": "^0.34.5",
    "uuid": "^9.0.0",
    "zod": "^4.3.5",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
