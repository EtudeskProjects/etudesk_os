{
  "name": "etudesk-backend",
  "version": "1.0.0",
  "description": "Backend API pour Etudesk",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/i18n/locales dist/i18n/locales",
    "start": "node dist/index.js",
    "seed": "tsx src/database/seed.ts",
    "db:reset": "psql $DATABASE_URL -f src/database/schema.sql && npm run seed",
    "db:migrate": "tsx src/database/run-migrations.ts",
    "db:migrate:community": "for f in src/database/migrations/01[4-8]*.sql; do psql $DATABASE_URL -f $f; done",
    "seed:pinecone": "tsx src/scripts/seed-pinecone.ts",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "test:skills": "tsx src/services/copilot/skills/__tests__/skill-loader.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@openai/agents": "^0.4.4",
    "@pinecone-database/pinecone": "^3.0.3",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-stringify": "^6.6.0",
    "docx": "^9.5.1",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "i18next": "^25.8.4",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.9.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "openai": "^4.70.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.0",
    "resend": "^6.9.1",
    "sharp": "^0.34.5",
    "uuid": "^9.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
