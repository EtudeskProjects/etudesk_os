{
  "expo": {
    "name": "Etudesk",
    "slug": "etudesk",
    "version": "1.1.0",
    "scheme": "etudesk",
    "icon": "./assets/etudesk_squared_icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/etudesk_logo_black.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.etudesk.os"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/etudesk_squared_icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.etudesk.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/etudesk_squared_icon.png",
          "color": "#18181B",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Etudesk a besoin d'accéder à vos photos pour mettre à jour votre photo de profil.",
          "cameraPermission": "Etudesk a besoin d'accéder à votre caméra pour prendre une photo de profil."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Etudesk a besoin d'accéder à votre localisation pour remplir automatiquement votre adresse.",
          "locationWhenInUsePermission": "Etudesk a besoin d'accéder à votre localisation pour remplir automatiquement votre adresse."
        }
      ],
      "expo-localization",
      "expo-audio",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c834045e-f5e4-4f29-9f03-9ae5078b2898"
      }
    },
    "owner": "etudesk"
  }
}
